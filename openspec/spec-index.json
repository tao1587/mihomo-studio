  "architecture": {
    "tauriCompositionRoot": "src-tauri/src/lib.rs",
    "expectedRustModules": [
      "application",
      "domain",
      "infrastructure",
      "interface"
    ],
    "expectedIpcCommands": [
      "build_profile_draft",
      "compile_strict_profile",
      "convert_node_text",
      "get_rule_catalog",
      "inspect_node_text",
      "inspect_subscription"
    ]
  },
  "contracts": {
    "compileProfileRequest": {
      "frontendPath": "src/shared/contracts.ts",
      "backendPath": "src-tauri/src/domain/compile/model.rs",
      "fields": [
        "mode",
        "selectedRuleSourceIds",
        "githubMirror",
        "sources",
        "bootstrapMappings"
      ],
      "secretBearingFields": [
        "sources",
        "bootstrapMappings"
      ]
    },
    "convertNodeTextRequest": {
      "frontendPath": "src/shared/contracts.ts",
      "backendPath": "src-tauri/src/domain/compile/model.rs",
      "fields": [
        "content"
      ],
      "secretBearingFields": [
        "content"
      ]
    },
    "convertNodeTextResult": {
      "frontendPath": "src/shared/contracts.ts",
      "backendPath": "src-tauri/src/domain/compile/model.rs",
      "fields": [
        "yaml",
        "templateYaml",
        "templateFileName",
        "nodeCount",
        "duplicateNodeCount",
        "compatibilityNormalizationCount",
        "warnings"
      ],
      "secretBearingFields": [
        "yaml",
        "templateYaml"
      ]
    }
  },
  "catalog": {
    "path": "src/data/rule-catalog.json",
    "schemaVersion": 1,
    "sourceCount": 10,
    "ruleSetCount": 12,
    "simpleDefaultSourceIds": [
      "acl4ssr"
    ],
    "finalRuleSetId": "builtin.match",
    "finalRuleOrder": 1000
  },
